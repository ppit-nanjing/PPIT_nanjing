DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (next-auth v5) - generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client - create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-deploy-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "true" on Vercel to redirect all traffic to /maintenance (src/proxy.ts)
MAINTENANCE_MODE="false"

# Email pengumuman kelulusan pendaftaran (Resend). Tanpa ini, perubahan status
# tetap tersimpan tapi email tidak dikirim (fitur mati, bukan error).
RESEND_API_KEY=
# Pengirim. Sebelum domain diverifikasi di Resend, biarkan kosong -> pakai
# "PPIT Nanjing <onboarding@resend.dev>" (hanya bisa kirim ke email pemilik akun Resend).
EMAIL_FROM=
