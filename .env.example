DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (next-auth v5) - generate with: npx auth secret
AUTH_SECRET=""
# Google OAuth client - create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-deploy-url>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Set to "true" on Vercel to redirect all traffic to /maintenance (src/proxy.ts)
MAINTENANCE_MODE="false"

# --- Email pengumuman kelulusan pendaftaran ---------------------------------
# Dua pilihan; kalau dua-duanya diisi, Gmail yang dipakai. Kalau tidak ada yang
# diisi, perubahan status tetap tersimpan tapi email tidak dikirim (fitur mati,
# bukan error).
#
# PILIHAN A - Gmail PPIT (tidak butuh domain sendiri, ~500 email/hari).
# Aktifkan Verifikasi 2 Langkah di akun itu, lalu buat App Password di
# https://myaccount.google.com/apppasswords (spasi boleh ikut disalin).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nama yang tampil di depan alamat Gmail. Default "PPIT Nanjing".
EMAIL_FROM_NAME=
#
# PILIHAN B - Resend. Hanya bisa kirim ke pendaftar kalau domain sendiri sudah
# diverifikasi di resend.com/domains dan EMAIL_FROM memakai domain itu.
# Tanpa domain, pengirim bawaan hanya sampai ke email pemilik akun Resend.
RESEND_API_KEY=
EMAIL_FROM=
