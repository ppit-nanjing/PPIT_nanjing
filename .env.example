# =============================================================================
# PPIT Nanjing — contoh environment variable
#
# Salin jadi `.env` untuk pengembangan lokal. Untuk produksi, isi nilainya di
# Vercel → Project Settings → Environment Variables.
#
# Panduan lengkap "ambil nilainya dari mana" + urutan migrasi akun ke Gmail
# PPIT Nanjing ada di docs/Setup Env & Migrasi Akun.md
#
# Tanda:
#   [WAJIB]   aplikasi tidak jalan / fitur intinya mati tanpa ini
#   [OPSIONAL] fitur mati dengan rapi kalau kosong, bukan error
# =============================================================================

# --- Database ---------------------------------------------------------------
# [WAJIB] Connection string Neon. Ambil dari Neon Console → Project → Connection
# Details → pilih "Pooled connection". Harus pakai ?sslmode=require.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js (next-auth v5) -------------------------------------------------
# [WAJIB] Kunci penanda tangan sesi JWT. Buat dengan: npx auth secret
# GANTI = semua orang yang sedang login ikut ter-logout. Itu wajar saat migrasi.
AUTH_SECRET=""

# [WAJIB] Google OAuth client — buat di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI yang harus didaftarkan (SEMUA yang dipakai):
#   http://localhost:3000/api/auth/callback/google
#   https://<domain-produksi>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Penyimpanan berkas -----------------------------------------------------
# [WAJIB untuk sensus] Token Vercel Blob. Vercel → Storage → buat Blob store →
# Connect ke project; Vercel menyuntikkan variabel ini otomatis di produksi.
# Untuk lokal, salin nilainya dari Storage → .env.local tab.
#
# TANPA INI /api/upload mengembalikan 503, dan karena Kartu Tanda Mahasiswa
# WAJIB di form sensus, TIDAK ADA anggota yang bisa menyelesaikan sensus —
# artinya tidak ada data yang bisa disetor ke PPI Tiongkok pusat.
BLOB_READ_WRITE_TOKEN=""

# --- Penjadwal (Vercel Cron) ------------------------------------------------
# [WAJIB kalau publish terjadwal dipakai] Melindungi /api/cron/publish-events.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# PERHATIAN: kalau dikosongkan, route itu TIDAK diperiksa sama sekali dan siapa
# pun yang tahu URL-nya bisa memicu publikasi acara. Isi selalu di produksi.
# Jadwalnya sendiri diatur di vercel.json.
CRON_SECRET=""

# --- Mode pemeliharaan ------------------------------------------------------
# [OPSIONAL] Set "true" di Vercel untuk mengalihkan semua lalu lintas ke
# /maintenance (src/proxy.ts). Kosong/"false" = situs normal.
MAINTENANCE_MODE="false"

# --- Chatbot bantuan --------------------------------------------------------
# [OPSIONAL] Groq API key untuk chatbot (src/lib/groq.ts). Ambil di
# https://console.groq.com/keys — kosong = chatbot mati, halaman lain normal.
GROQ_API_KEY=""

# --- Email pengumuman kelulusan pendaftaran ---------------------------------
# [OPSIONAL] Dua pilihan; kalau dua-duanya diisi, Gmail yang dipakai. Kalau
# tidak ada yang diisi, perubahan status tetap tersimpan tapi email tidak
# dikirim (fitur mati, bukan error).
#
# PILIHAN A - Gmail PPIT (tidak butuh domain sendiri, ~500 email/hari).
# Aktifkan Verifikasi 2 Langkah di akun itu, lalu buat App Password di
# https://myaccount.google.com/apppasswords (spasi boleh ikut disalin).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Nama yang tampil di depan alamat Gmail. Default "PPIT Nanjing".
EMAIL_FROM_NAME=
#
# PILIHAN B - Resend. Hanya bisa kirim ke pendaftar kalau domain sendiri sudah
# diverifikasi di resend.com/domains dan EMAIL_FROM memakai domain itu.
# Tanpa domain, pengirim bawaan hanya sampai ke email pemilik akun Resend.
RESEND_API_KEY=
EMAIL_FROM=
